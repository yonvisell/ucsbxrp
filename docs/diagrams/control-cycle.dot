digraph ControlCycle {
  graph [
    bgcolor="transparent",
    fontname="Arial",
    nodesep=0.38,
    pad=0.08,
    rankdir=TB,
    ranksep=0.72,
    splines=polyline
  ];
  node [
    color="#667984",
    fillcolor="#ffffff",
    fontcolor="#17343f",
    fontname="Arial",
    fontsize=11,
    margin="0.12,0.08",
    penwidth=1.1,
    shape=box,
    style="rounded,filled"
  ];
  edge [
    arrowsize=0.65,
    color="#4d616b",
    fontcolor="#3f5058",
    fontname="Arial",
    fontsize=9,
    penwidth=1.1
  ];

  main [label="main.py or\nsupplied mission", color="#00588a", fillcolor="#eef4f7"];
  robot [label="Robot.step()\norchestrates sample", color="#00588a", fillcolor="#eef4f7"];
  target [label="Selected XRP target\nmotors and sensors", color="#8d7440", fillcolor="#f8f5ed"];

  drive [label="DifferentialDrive*\nWheelSpeeds", color="#39736f", fillcolor="#f3f8f7"];
  controller [label="WheelSpeedController*\nDriveCommand", color="#39736f", fillcolor="#f3f8f7"];
  bot [label="XRPBot\ndevice boundary", color="#667984", fillcolor="#ffffff"];
  sensor [label="SensorModel*\nMeasurements", color="#39736f", fillcolor="#f3f8f7"];
  odometry [label="Odometry*\nPose", color="#39736f", fillcolor="#f3f8f7"];
  state [label="RobotState\nMeasurements + Pose", color="#667984", fillcolor="#ffffff"];

  { rank=same; main; robot; drive; controller; }
  { rank=same; target; bot; sensor; odometry; state; }

  main -> robot [label="MotionCommand"];
  robot -> drive [label="calls component"];
  drive -> controller [label="target wheel speeds"];
  controller -> bot [label="motor command"];
  target -> bot [label="motor output /\nsensor readings", dir=both];
  bot -> sensor [label="RawSensors"];
  sensor -> odometry [label="wheel increments"];
  sensor -> state [label="Measurements"];
  odometry -> state [label="Pose"];
  state -> main [label="RobotState", constraint=false];
  sensor -> controller [
    label="latest measured wheel speeds\n(next step)",
    color="#006c64",
    fontcolor="#005f58",
    style=dashed,
    constraint=false
  ];
}
