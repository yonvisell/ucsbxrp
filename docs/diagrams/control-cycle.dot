digraph ControlCycle {
  graph [
    bgcolor="transparent",
    fontname="Arial",
    nodesep=0.5,
    pad=0.08,
    rankdir=TB,
    ranksep=0.58,
    splines=polyline
  ];
  node [
    color="#667984",
    fillcolor="#ffffff",
    fontcolor="#17343f",
    fontname="Arial",
    fontsize=11,
    margin="0.12,0.08",
    penwidth=1.1,
    shape=box,
    style="rounded,filled"
  ];
  edge [
    arrowsize=0.65,
    color="#4d616b",
    fontcolor="#3f5058",
    fontname="Arial",
    fontsize=9,
    penwidth=1.1
  ];

  program [label="main.py or supplied mission\ncoordinates the task", color="#00588a", fillcolor="#eef4f7"];
  robot [label="Robot.step()\none control-loop update", color="#00588a", fillcolor="#eef4f7"];
  motion [label="Selected motor-control classes\nDifferentialDrive\nWheelSpeedController", color="#39736f", fillcolor="#f3f8f7"];
  bot_command [label="XRPBot\nsend motor command", color="#667984", fillcolor="#ffffff"];
  bot_sample [label="XRPBot\nread sensors", color="#667984", fillcolor="#ffffff"];
  target [label="Selected target\nVirtual or Physical XRP", color="#8d7440", fillcolor="#f8f5ed"];
  measurement [label="Selected measurement classes\nSensorModel\nOdometry", color="#39736f", fillcolor="#f3f8f7"];
  state [label="RobotState\nMeasurements + Pose", color="#667984", fillcolor="#ffffff"];

  { rank=same; program; state; }
  { rank=same; robot; measurement; }
  { rank=same; motion; bot_sample; }
  { rank=same; bot_command; target; }

  program -> robot [label="MotionCommand"];
  robot -> motion [label="calls"];
  motion -> bot_command [label="DriveCommand"];
  bot_command -> target [label="device command"];
  state -> measurement [style=invis, weight=20];
  measurement -> bot_sample [style=invis, weight=20];
  bot_sample -> target [style=invis, weight=20];
  target -> bot_sample [label="device readings", constraint=false];
  bot_sample -> measurement [label="RawSensors", constraint=false];
  measurement -> state [label="estimates", constraint=false];
  state -> program [label="RobotState", constraint=false];
  measurement -> motion [
    label="measured WheelSpeeds",
    color="#006c64",
    fontcolor="#005f58",
    style=dashed,
    constraint=false
  ];
}
