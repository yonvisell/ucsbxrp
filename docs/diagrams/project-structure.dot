digraph ProjectStructure {
  graph [
    bgcolor="transparent",
    fontname="Arial",
    nodesep=0.45,
    pad=0.08,
    rankdir=LR,
    ranksep=0.62,
    splines=polyline
  ];
  node [
    color="#667984",
    fillcolor="#ffffff",
    fontcolor="#17343f",
    fontname="Arial",
    fontsize=11,
    margin="0.13,0.08",
    penwidth=1.1,
    shape=box,
    style="rounded,filled"
  ];
  edge [
    arrowsize=0.65,
    color="#4d616b",
    fontcolor="#3f5058",
    fontname="Arial",
    fontsize=9,
    penwidth=1.1
  ];

  world [label="world.json\narena and task markers", color="#8d7440", fillcolor="#f8f5ed"];
  loader [label="load_world()"];
  challenge [label="challenge.py\ntask values", color="#39736f", fillcolor="#f3f8f7"];

  config [label="robot_config.py\ngeometry and settings", color="#8d7440", fillcolor="#f8f5ed"];
  components [label="student component files\nselected implementations", color="#39736f", fillcolor="#f3f8f7"];
  setup [label="course_setup.py\nconstructs services", color="#39736f", fillcolor="#f3f8f7"];

  program [label="main.py or supplied mission\ncoordinates the task", color="#00588a", fillcolor="#eef4f7"];

  { rank=same; world; config; components; }
  { rank=same; challenge; setup; }

  world -> loader;
  loader -> challenge;
  challenge -> program [label="task values"];
  config -> setup [label="configuration"];
  components -> setup [label="component classes"];
  setup -> program [label="selected services"];
}
