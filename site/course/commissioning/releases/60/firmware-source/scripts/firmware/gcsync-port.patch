+
+#if MICROPY_RP2_GCSYNC
+bool pendsv_is_locked_by_current_core(void) {
+    // Called only on the uncommon GC rendezvous path.  Parking a native
+    // network-lock owner would obstruct socket finalizers after early resume.
+    return __atomic_load_n(&pendsv_mutex.mutex.owner, __ATOMIC_RELAXED) == lock_get_caller_owner_id();
+}
+#endif
 
 void pendsv_resume(void) {
     mp_thread_recursive_mutex_unlock(&pendsv_mutex);
